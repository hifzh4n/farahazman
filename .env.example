# Example environment variables
# Copy to `.env` locally and fill with real values. Do NOT commit secrets.

# Public client-side API base URL
NEXT_PUBLIC_API_URL=https://api.example.com

# Analytics or third-party keys (example placeholders)
NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id_here

# Server-side secrets should never be committed
# Example: DATABASE_URL=postgres://user:password@host:5432/dbname
# Keep them in your deployment environment's secret manager.
